# Copiar este archivo como .env y llenar los valores.
# El .env NUNCA se sube al repositorio.

# Google Places API (New)
# Restringida a Places API (New), cuota SearchTextRequest = 500/día
GOOGLE_PLACES_API_KEY=

# Anthropic — clasificador, redactor y validador
# Recarga automática APAGADA a propósito: quedarse sin saldo es el freno
ANTHROPIC_API_KEY=

# Además del .env hace falta credenciales.json en la raíz:
# cuenta de servicio de Google con permiso de escritura sobre la hoja
# "Prospectos Embutidos Artesanales".
# Ese archivo tampoco se sube al repositorio.